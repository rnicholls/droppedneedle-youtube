{
  "manifest_version": 3,
  "name": "DroppedNeedle for YouTube",
  "version": "0.3.0",
  "description": "Identify a song on YouTube and request it through DroppedNeedle.",
  "permissions": ["activeTab", "storage", "cookies"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://droppedneedle.nodehaven.ca/*"
  ],
  "action": {
    "default_title": "Add to DroppedNeedle",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/watch*", "https://youtube.com/watch*"],
      "js": ["content.js"],
      "css": ["youtube.css"]
    }
  ],
  "options_page": "options.html"
}
